# encom-hits -- ai.cyr
# Shared AI: maze-aware A* (Battle Tanks) and the Light Cycles lookahead.
#
# Grid Bugs uses neither. Its grid is fully connected apart from the outer
# edge, so the greedy one-axis step in gridbugs.cyr is already a shortest path
# and A* would return a path of the same length at many times the cost. Until
# 0.8.3 this file also carried an open-grid A* (ai_find_direction) and a greedy
# ai_chase_direction for it; neither had a caller, so both were removed.

# A* working set, one slot per cell. Sized for the only grid A* runs on, the
# Battle Tanks maze (TK_GRID_W * TK_GRID_H = 16 * 12 = 192 cells), and guarded
# by AI_MAX_CELLS below. Until 0.8.3 these were 4,800 slots apiece, sized for
# the Light Cycles grid that never used them: 192,000 bytes of static data,
# three quarters of the binary's total.
enum AiConst {
    AI_MAX_CELLS = 192;
}
var _ai_g_cost[192];
var _ai_f_cost[192];
var _ai_parent[192];
var _ai_closed[192];
var _ai_open[192];
var _ai_open_count = 0;

fn _ai_abs(x) {
    if (x < 0) { return 0 - x; }
    return x;
}

# Manhattan distance heuristic (admissible for 4-connected grid)
fn _ai_manhattan(x0, y0, x1, y1) {
    return _ai_abs(x1 - x0) + _ai_abs(y1 - y0);
}

# Reset the A* working set for a `total`-cell search.
#
# Only the open and closed flags need clearing. g, f and parent are read only
# for a cell that is open or closed, and both happen after the cell's own entry
# was written when it was opened (the start cell's are written explicitly), so
# stale values from an earlier search are never reached. Word stores, not
# memset: the stdlib memset is a byte loop, and this used to clear all five
# arrays with it on every tank tick (7,680 byte iterations per search).
fn _ai_reset(total) {
    var i = 0;
    while (i < total) {
        store64(&_ai_open + i * 8, 0);
        store64(&_ai_closed + i * 8, 0);
        i = i + 1;
    }
    return 0;
}

# A* pathfinding that respects maze walls (for Battle Tanks).
# Returns the FIRST step (DIR_UP/DOWN/LEFT/RIGHT) of a shortest path from
# (sx,sy) to (gx,gy), checking maze_has_wall before expanding a neighbour, or
# DIR_NONE when start == goal, the goal is unreachable, or the grid exceeds
# AI_MAX_CELLS.
# Wall direction map: d0=up->N(0), d1=down->S(1), d2=left->W(3), d3=right->E(2)
fn ai_find_direction_maze(sx, sy, gx, gy, grid_w, grid_h) {
    if (sx == gx) {
        if (sy == gy) { return DIR_NONE; }
    }

    var total = grid_w * grid_h;
    if (total > AI_MAX_CELLS) { return DIR_NONE; }

    _ai_reset(total);

    var start = sy * grid_w + sx;
    var goal = gy * grid_w + gx;
    store64(&_ai_g_cost + start * 8, 0);
    store64(&_ai_f_cost + start * 8, _ai_manhattan(sx, sy, gx, gy));
    store64(&_ai_parent + start * 8, 0 - 1);
    store64(&_ai_open + start * 8, 1);
    _ai_open_count = 1;

    var iterations = 0;
    var max_iter = total;

    while (_ai_open_count > 0) {
        iterations = iterations + 1;
        if (iterations > max_iter) { return DIR_NONE; }

        var best = 0 - 1;
        var best_f = 999999;
        var i = 0;
        while (i < total) {
            if (load64(&_ai_open + i * 8) == 1) {
                var f = load64(&_ai_f_cost + i * 8);
                if (f < best_f) {
                    best_f = f;
                    best = i;
                }
            }
            i = i + 1;
        }

        if (best < 0) { return DIR_NONE; }

        if (best == goal) {
            var node = goal;
            var prev = load64(&_ai_parent + node * 8);
            while (prev != start) {
                if (prev < 0) { return DIR_NONE; }
                node = prev;
                prev = load64(&_ai_parent + node * 8);
            }
            var nx = node % grid_w;
            var ny = node / grid_w;
            if (nx == sx + 1) { return DIR_RIGHT; }
            if (nx == sx - 1) { return DIR_LEFT; }
            if (ny == sy - 1) { return DIR_UP; }
            if (ny == sy + 1) { return DIR_DOWN; }
            return DIR_NONE;
        }

        store64(&_ai_open + best * 8, 0);
        _ai_open_count = _ai_open_count - 1;
        store64(&_ai_closed + best * 8, 1);

        var cx = best % grid_w;
        var cy = best / grid_w;
        var g = load64(&_ai_g_cost + best * 8);

        # Check 4 neighbors, only expand if no wall blocks passage
        var d = 0;
        while (d < 4) {
            # Map neighbor direction to maze wall direction
            var wall_dir = d;
            if (d == 2) { wall_dir = 3; }  # left -> W
            if (d == 3) { wall_dir = 2; }  # right -> E

            if (maze_has_wall(cx, cy, wall_dir) == 0) {
                var nx = cx;
                var ny = cy;
                if (d == 0) { ny = cy - 1; }
                if (d == 1) { ny = cy + 1; }
                if (d == 2) { nx = cx - 1; }
                if (d == 3) { nx = cx + 1; }

                if (nx >= 0) {
                    if (nx < grid_w) {
                        if (ny >= 0) {
                            if (ny < grid_h) {
                                var ni = ny * grid_w + nx;
                                if (load64(&_ai_closed + ni * 8) == 0) {
                                    var new_g = g + 1;
                                    var old_g = load64(&_ai_g_cost + ni * 8);
                                    var in_open = load64(&_ai_open + ni * 8);

                                    if (in_open == 0) {
                                        store64(&_ai_g_cost + ni * 8, new_g);
                                        store64(&_ai_f_cost + ni * 8, new_g + _ai_manhattan(nx, ny, gx, gy));
                                        store64(&_ai_parent + ni * 8, best);
                                        store64(&_ai_open + ni * 8, 1);
                                        _ai_open_count = _ai_open_count + 1;
                                    } else {
                                        if (new_g < old_g) {
                                            store64(&_ai_g_cost + ni * 8, new_g);
                                            store64(&_ai_f_cost + ni * 8, new_g + _ai_manhattan(nx, ny, gx, gy));
                                            store64(&_ai_parent + ni * 8, best);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            d = d + 1;
        }
    }

    return DIR_NONE;
}

# Light Cycles AI: avoid walls with lookahead, try to survive
# Returns best direction for the AI cycle
fn ai_lightcycles(x, y, cur_dir, grid_w, grid_h) {
    # Check which directions are safe (no immediate collision)
    var safe_up = 0;
    var safe_down = 0;
    var safe_left = 0;
    var safe_right = 0;

    if (y - 1 >= 0) {
        if (lc_cell(x, y - 1) == 0) { safe_up = 1; }
    }
    if (y + 1 < grid_h) {
        if (lc_cell(x, y + 1) == 0) { safe_down = 1; }
    }
    if (x - 1 >= 0) {
        if (lc_cell(x - 1, y) == 0) { safe_left = 1; }
    }
    if (x + 1 < grid_w) {
        if (lc_cell(x + 1, y) == 0) { safe_right = 1; }
    }

    # Count safe space ahead (lookahead)
    var best_dir = cur_dir;
    var best_space = 0;

    # Check each safe direction: count consecutive empty cells
    if (safe_up) {
        var space = 0;
        var ty = y - 1;
        while (ty >= 0) {
            if (lc_cell(x, ty) != 0) { ty = 0 - 1; }
            else { space = space + 1; ty = ty - 1; }
        }
        if (space > best_space) { best_space = space; best_dir = DIR_UP; }
    }
    if (safe_down) {
        var space = 0;
        var ty = y + 1;
        while (ty < grid_h) {
            if (lc_cell(x, ty) != 0) { ty = grid_h; }
            else { space = space + 1; ty = ty + 1; }
        }
        if (space > best_space) { best_space = space; best_dir = DIR_DOWN; }
    }
    if (safe_left) {
        var space = 0;
        var tx = x - 1;
        while (tx >= 0) {
            if (lc_cell(tx, y) != 0) { tx = 0 - 1; }
            else { space = space + 1; tx = tx - 1; }
        }
        if (space > best_space) { best_space = space; best_dir = DIR_LEFT; }
    }
    if (safe_right) {
        var space = 0;
        var tx = x + 1;
        while (tx < grid_w) {
            if (lc_cell(tx, y) != 0) { tx = grid_w; }
            else { space = space + 1; tx = tx + 1; }
        }
        if (space > best_space) { best_space = space; best_dir = DIR_RIGHT; }
    }

    # If current direction is safe and has decent space, prefer it (avoid jitter)
    if (cur_dir == DIR_UP) {
        if (safe_up) {
            var space = 0;
            var ty = y - 1;
            while (ty >= 0) {
                if (lc_cell(x, ty) != 0) { ty = 0 - 1; }
                else { space = space + 1; ty = ty - 1; }
            }
            if (space >= best_space / 2) { return cur_dir; }
        }
    }
    if (cur_dir == DIR_DOWN) {
        if (safe_down) {
            var space = 0;
            var ty = y + 1;
            while (ty < grid_h) {
                if (lc_cell(x, ty) != 0) { ty = grid_h; }
                else { space = space + 1; ty = ty + 1; }
            }
            if (space >= best_space / 2) { return cur_dir; }
        }
    }
    if (cur_dir == DIR_LEFT) {
        if (safe_left) {
            var space = 0;
            var tx = x - 1;
            while (tx >= 0) {
                if (lc_cell(tx, y) != 0) { tx = 0 - 1; }
                else { space = space + 1; tx = tx - 1; }
            }
            if (space >= best_space / 2) { return cur_dir; }
        }
    }
    if (cur_dir == DIR_RIGHT) {
        if (safe_right) {
            var space = 0;
            var tx = x + 1;
            while (tx < grid_w) {
                if (lc_cell(tx, y) != 0) { tx = grid_w; }
                else { space = space + 1; tx = tx + 1; }
            }
            if (space >= best_space / 2) { return cur_dir; }
        }
    }

    return best_dir;
}
