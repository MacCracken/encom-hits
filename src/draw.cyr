# encom-hits -- drawing primitives
# Everything is lines. The art is math.
# Bresenham's line algorithm is the foundation -- every visual builds from it.

# Every primitive below writes a pixel as ONE 32-bit store of
# `color | 0xFF000000`. On this little-endian surface that is exactly the four
# bytes B, G, R, 0xFF the primitives wrote one byte at a time through 0.8.2, so
# the output is byte-identical (all 14 reference frames are unchanged) at a
# quarter of the stores.

# Draw a line using Bresenham's algorithm.
# All game visuals are composed of lines -- no sprites, no textures.
fn draw_line(fb, x0, y0, x1, y1, color) {
    var dx = x1 - x0;
    var dy = y1 - y0;
    if (dx < 0) { dx = 0 - dx; }
    if (dy < 0) { dy = 0 - dy; }

    var sx = 1;
    if (x0 > x1) { sx = 0 - 1; }
    var sy = 1;
    if (y0 > y1) { sy = 0 - 1; }

    var err = dx - dy;
    var x = x0;
    var y = y0;
    var px = color | 0xFF000000;

    while (1) {
        # Plot pixel if in bounds
        if (x >= 0) {
            if (x < SCREEN_W) {
                if (y >= 0) {
                    if (y < SCREEN_H) {
                        store32(fb + (y * SCREEN_W + x) * 4, px);
                    }
                }
            }
        }

        if (x == x1) {
            if (y == y1) {
                return 0;
            }
        }

        var e2 = err * 2;
        if (e2 > (0 - dy)) {
            err = err - dy;
            x = x + sx;
        }
        if (e2 < dx) {
            err = err + dx;
            y = y + sy;
        }
    }
    return 0;
}

# Draw a horizontal line (fast path -- no Bresenham needed).
fn draw_hline(fb, x0, x1, y, color) {
    if (y < 0) { return 0; }
    if (y >= SCREEN_H) { return 0; }
    var start = x0;
    var end = x1;
    if (start > end) { var tmp = start; start = end; end = tmp; }
    if (start < 0) { start = 0; }
    if (end >= SCREEN_W) { end = SCREEN_W - 1; }

    var px = color | 0xFF000000;
    var p = fb + (y * SCREEN_W + start) * 4;
    var e = fb + (y * SCREEN_W + end) * 4;
    while (p <= e) {
        store32(p, px);
        p = p + 4;
    }
    return 0;
}

# Draw a vertical line (fast path).
fn draw_vline(fb, x, y0, y1, color) {
    if (x < 0) { return 0; }
    if (x >= SCREEN_W) { return 0; }
    var start = y0;
    var end = y1;
    if (start > end) { var tmp = start; start = end; end = tmp; }
    if (start < 0) { start = 0; }
    if (end >= SCREEN_H) { end = SCREEN_H - 1; }

    var px = color | 0xFF000000;
    var p = fb + (start * SCREEN_W + x) * 4;
    var e = fb + (end * SCREEN_W + x) * 4;
    while (p <= e) {
        store32(p, px);
        p = p + SCREEN_W * 4;
    }
    return 0;
}

# Draw a rectangle outline.
fn draw_rect(fb, x, y, w, h, color) {
    draw_hline(fb, x, x + w - 1, y, color);
    draw_hline(fb, x, x + w - 1, y + h - 1, color);
    draw_vline(fb, x, y, y + h - 1, color);
    draw_vline(fb, x + w - 1, y, y + h - 1, color);
    return 0;
}

# Fill a rectangle.
fn draw_filled_rect(fb, x, y, w, h, color) {
    var row = 0;
    while (row < h) {
        draw_hline(fb, x, x + w - 1, y + row, color);
        row = row + 1;
    }
    return 0;
}

# Clear the framebuffer to black.
fn draw_clear(fb) {
    # Word-wise clear, not memset: the vendored stdlib memset is a byte-at-a-time
    # loop (lib/string.cyr), so clearing the 307,200-byte surface cost ~8.3M
    # instructions on EVERY frame of every game — this is the single hottest
    # call in the engine (10 call sites, all per-frame). The surface is always
    # _fb_ptr, which alloc() returns 8-byte aligned, and its size is an exact
    # multiple of 8, so 64-bit stores are equivalent and run 8x fewer iterations.
    #
    # NOTE: the right-nested grouping worked around a cyrius 6.0.x mis-fold of
    # a chained `enum * enum * literal` (it dropped the first factor → 960, not
    # 307200). Fixed upstream in cyrius 6.1.37; kept as-is on the pinned toolchain.
    var p = fb;
    var end = fb + SCREEN_W * (SCREEN_H * 4);
    while (p < end) {
        store64(p, 0);
        p = p + 8;
    }
    return 0;
}

# Plot a single pixel.
fn draw_pixel(fb, x, y, color) {
    if (x < 0) { return 0; }
    if (x >= SCREEN_W) { return 0; }
    if (y < 0) { return 0; }
    if (y >= SCREEN_H) { return 0; }
    store32(fb + (y * SCREEN_W + x) * 4, color | 0xFF000000);
    return 0;
}
