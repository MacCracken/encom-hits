# encom-hits -- Battle Tanks
# Top-down tank combat in a procedural maze.
# Projectile physics with wall ricochet. AI opponent.
#
# Grid: 16x12 cells, 20x20 pixels each.
# Player tank vs AI tank. Shots ricochet off walls (max 2 bounces).

# Tank state
var tk_p1_x = 0;
var tk_p1_y = 0;
var tk_p1_dir = 0;
var tk_p1_alive = 0;

var tk_ai_x = 0;
var tk_ai_y = 0;
var tk_ai_dir = 0;
var tk_ai_alive = 0;

# Projectiles: one live shot per tank, slot TK_SHOT_P1 for the player and
# TK_SHOT_AI for the AI, TS_FIELDS fields each. Until 0.8.3 these were twelve
# named globals driven by two copies of the same updater, one per shooter.
enum TkShot {
    TK_SHOT_P1 = 0;
    TK_SHOT_AI = 1;
    TS_X       = 0;
    TS_Y       = 1;
    TS_DX      = 2;
    TS_DY      = 3;
    TS_ALIVE   = 4;
    TS_BOUNCES = 5;
    TS_FIELDS  = 6;
}
var _tk_shot[12];

fn _tk_shot_get(s, f) { return load64(&_tk_shot + (s * TS_FIELDS + f) * 8); }
fn _tk_shot_set(s, f, v) { store64(&_tk_shot + (s * TS_FIELDS + f) * 8, v); return 0; }

fn tk_shot_alive(s) { return _tk_shot_get(s, TS_ALIVE); }
fn tk_shot_x(s) { return _tk_shot_get(s, TS_X); }
fn tk_shot_y(s) { return _tk_shot_get(s, TS_Y); }

# Latched player move request, applied once per game tick by
# tk_apply_pending_move (main loop input only latches it).
var tk_p1_pending = DIR_NONE;

# AI shoot cooldown
var tk_ai_cooldown = 0;

fn tk_init(seed) {
    # Generate maze
    maze_generate(TK_GRID_W, TK_GRID_H, seed);

    # Player starts at top-left area
    tk_p1_x = 1;
    tk_p1_y = 1;
    tk_p1_dir = DIR_RIGHT;
    tk_p1_alive = 1;

    # AI starts at bottom-right area
    tk_ai_x = TK_GRID_W - 2;
    tk_ai_y = TK_GRID_H - 2;
    tk_ai_dir = DIR_LEFT;
    tk_ai_alive = 1;

    # No active projectiles, no move queued from the previous run
    _tk_shot_set(TK_SHOT_P1, TS_ALIVE, 0);
    _tk_shot_set(TK_SHOT_AI, TS_ALIVE, 0);
    tk_ai_cooldown = 0;
    tk_p1_pending = DIR_NONE;

    return 0;
}

fn tk_try_move(x, y, dir) {
    # Check if movement in direction is allowed (no wall)
    var wall_dir = 0;
    if (dir == DIR_UP) { wall_dir = 0; }
    if (dir == DIR_DOWN) { wall_dir = 1; }
    if (dir == DIR_RIGHT) { wall_dir = 2; }
    if (dir == DIR_LEFT) { wall_dir = 3; }

    if (maze_has_wall(x, y, wall_dir) == 0) {
        return 1;
    }
    return 0;
}

# Apply the latched request: exactly one cell, on one axis, per game tick.
fn tk_apply_pending_move() {
    var d = tk_p1_pending;
    tk_p1_pending = DIR_NONE;
    if (tk_p1_alive == 0) { return 0; }
    if (d == DIR_NONE) { return 0; }
    if (tk_try_move(tk_p1_x, tk_p1_y, d) == 0) { return 0; }
    if (d == DIR_UP)    { tk_p1_y = tk_p1_y - 1; }
    if (d == DIR_DOWN)  { tk_p1_y = tk_p1_y + 1; }
    if (d == DIR_LEFT)  { tk_p1_x = tk_p1_x - 1; }
    if (d == DIR_RIGHT) { tk_p1_x = tk_p1_x + 1; }
    return 0;
}

fn tk_fire_shot(x, y, dir, is_player) {
    var s = TK_SHOT_AI;
    if (is_player) { s = TK_SHOT_P1; }
    if (_tk_shot_get(s, TS_ALIVE) != 0) { return 0; }

    var dx = 0;
    var dy = 0;
    if (dir == DIR_UP) { dy = 0 - 1; }
    if (dir == DIR_DOWN) { dy = 1; }
    if (dir == DIR_LEFT) { dx = 0 - 1; }
    if (dir == DIR_RIGHT) { dx = 1; }

    _tk_shot_set(s, TS_X, x);
    _tk_shot_set(s, TS_Y, y);
    _tk_shot_set(s, TS_DX, dx);
    _tk_shot_set(s, TS_DY, dy);
    _tk_shot_set(s, TS_ALIVE, 1);
    _tk_shot_set(s, TS_BOUNCES, 0);
    return 0;
}

# Advance shot `s` one cell. Returns 1 when it hits the tank at (tx, ty); the
# caller decides whose tank that is.
fn _tk_update_shot(s, tx, ty) {
    if (_tk_shot_get(s, TS_ALIVE) == 0) { return 0; }
    var x = _tk_shot_get(s, TS_X);
    var y = _tk_shot_get(s, TS_Y);
    var dx = _tk_shot_get(s, TS_DX);
    var dy = _tk_shot_get(s, TS_DY);

    # Test the cell the shot is ON before advancing. Through 0.6.3 the updaters
    # moved first and only tested the destination, so an enemy standing on the
    # shot's own cell was a blind spot the projectile passed straight through.
    if (x == tx) {
        if (y == ty) {
            _tk_shot_set(s, TS_ALIVE, 0);
            return 1;
        }
    }

    # Wall collision: a ricochet reverses the shot in place and costs a bounce.
    var wall_dir = 0;
    if (dx > 0) { wall_dir = 2; }
    if (dx < 0) { wall_dir = 3; }
    if (dy < 0) { wall_dir = 0; }
    if (dy > 0) { wall_dir = 1; }
    if (maze_has_wall(x, y, wall_dir)) {
        if (dx != 0) { _tk_shot_set(s, TS_DX, 0 - dx); }
        if (dy != 0) { _tk_shot_set(s, TS_DY, 0 - dy); }
        var bounces = _tk_shot_get(s, TS_BOUNCES) + 1;
        _tk_shot_set(s, TS_BOUNCES, bounces);
        if (bounces > TK_MAX_BOUNCES) { _tk_shot_set(s, TS_ALIVE, 0); }
        return 0;
    }

    var nx = x + dx;
    var ny = y + dy;
    if (nx < 0) { _tk_shot_set(s, TS_ALIVE, 0); return 0; }
    if (nx >= TK_GRID_W) { _tk_shot_set(s, TS_ALIVE, 0); return 0; }
    if (ny < 0) { _tk_shot_set(s, TS_ALIVE, 0); return 0; }
    if (ny >= TK_GRID_H) { _tk_shot_set(s, TS_ALIVE, 0); return 0; }
    _tk_shot_set(s, TS_X, nx);
    _tk_shot_set(s, TS_Y, ny);

    if (nx == tx) {
        if (ny == ty) {
            _tk_shot_set(s, TS_ALIVE, 0);
            return 1;
        }
    }
    return 0;
}

fn tk_update() {
    # AI movement: A* pathfinding through maze
    if (tk_ai_alive) {
        var dir = ai_find_direction_maze(tk_ai_x, tk_ai_y, tk_p1_x, tk_p1_y, TK_GRID_W, TK_GRID_H);
        if (dir != DIR_NONE) {
            # Where that step would land.
            var nx = tk_ai_x;
            var ny = tk_ai_y;
            if (dir == DIR_UP) { ny = ny - 1; }
            if (dir == DIR_DOWN) { ny = ny + 1; }
            if (dir == DIR_LEFT) { nx = nx - 1; }
            if (dir == DIR_RIGHT) { nx = nx + 1; }

            # Stop one cell short. The A* goal is the player's exact cell, and
            # ai_find_direction_maze returns DIR_NONE once start == goal, so
            # through 0.6.3 the AI walked onto a stationary player and then
            # froze there forever — and because it is drawn second, its orange
            # square completely hid the player's cyan one. Refusing the last
            # step keeps it adjacent, facing the player, and still shooting.
            var onto_player = 0;
            if (nx == tk_p1_x) {
                if (ny == tk_p1_y) { onto_player = 1; }
            }

            # Face the player either way, so the shot goes down the right line.
            tk_ai_dir = dir;
            if (onto_player == 0) {
                if (tk_try_move(tk_ai_x, tk_ai_y, dir)) {
                    tk_ai_x = nx;
                    tk_ai_y = ny;
                }
            }
        }

        # AI fires periodically
        tk_ai_cooldown = tk_ai_cooldown + 1;
        if (tk_ai_cooldown >= 8) {
            tk_ai_cooldown = 0;
            tk_fire_shot(tk_ai_x, tk_ai_y, tk_ai_dir, 0);
        }
    }

    # Update projectiles: the player's first, then the AI's
    if (_tk_update_shot(TK_SHOT_P1, tk_ai_x, tk_ai_y) == 1) { tk_ai_alive = 0; }
    if (_tk_update_shot(TK_SHOT_AI, tk_p1_x, tk_p1_y) == 1) { tk_p1_alive = 0; }

    return 0;
}

fn tk_render(fb) {
    draw_clear(fb);

    # Draw maze
    maze_render(fb, TK_CELL_W, TK_CELL_H, COLOR_BLUE);

    # Player tank (cyan filled rect with direction indicator)
    if (tk_p1_alive) {
        var px = tk_p1_x * TK_CELL_W + TK_CELL_W / 2;
        var py = tk_p1_y * TK_CELL_H + TK_CELL_H / 2;
        draw_filled_rect(fb, px - 3, py - 3, 7, 7, COLOR_CYAN);
        # Direction barrel
        if (tk_p1_dir == DIR_UP)    { draw_vline(fb, px, py - 6, py - 3, COLOR_WHITE); }
        if (tk_p1_dir == DIR_DOWN)  { draw_vline(fb, px, py + 3, py + 6, COLOR_WHITE); }
        if (tk_p1_dir == DIR_LEFT)  { draw_hline(fb, px - 6, px - 3, py, COLOR_WHITE); }
        if (tk_p1_dir == DIR_RIGHT) { draw_hline(fb, px + 3, px + 6, py, COLOR_WHITE); }
    }

    # AI tank (orange)
    if (tk_ai_alive) {
        var ax = tk_ai_x * TK_CELL_W + TK_CELL_W / 2;
        var ay = tk_ai_y * TK_CELL_H + TK_CELL_H / 2;
        draw_filled_rect(fb, ax - 3, ay - 3, 7, 7, COLOR_ORANGE);
        if (tk_ai_dir == DIR_UP)    { draw_vline(fb, ax, ay - 6, ay - 3, COLOR_WHITE); }
        if (tk_ai_dir == DIR_DOWN)  { draw_vline(fb, ax, ay + 3, ay + 6, COLOR_WHITE); }
        if (tk_ai_dir == DIR_LEFT)  { draw_hline(fb, ax - 6, ax - 3, ay, COLOR_WHITE); }
        if (tk_ai_dir == DIR_RIGHT) { draw_hline(fb, ax + 3, ax + 6, ay, COLOR_WHITE); }
    }

    # Projectiles (white), the player's then the AI's
    var shot = TK_SHOT_P1;
    while (shot <= TK_SHOT_AI) {
        if (_tk_shot_get(shot, TS_ALIVE)) {
            var sx = _tk_shot_get(shot, TS_X) * TK_CELL_W + TK_CELL_W / 2;
            var sy = _tk_shot_get(shot, TS_Y) * TK_CELL_H + TK_CELL_H / 2;
            draw_filled_rect(fb, sx - 1, sy - 1, 3, 3, COLOR_WHITE);
        }
        shot = shot + 1;
    }

    return 0;
}

fn tk_game_over() {
    if (tk_p1_alive == 0) { return 1; }
    if (tk_ai_alive == 0) { return 1; }
    return 0;
}

fn tk_winner() {
    if (tk_p1_alive == 1) { if (tk_ai_alive == 0) { return 1; } }
    if (tk_ai_alive == 1) { if (tk_p1_alive == 0) { return 2; } }
    return 0;
}
