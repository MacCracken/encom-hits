# encom-hits -- ENCOM's Hits
# Retro arcade game collection in Cyrius.
# Six games. Neon on black. The art is math.
#
# Light Cycles | Grid Bugs | Battle Tanks | MCP Cone | Interceptors | Disc Arena
#
# Build: cyrius build src/main.cyr build/encom-hits
# Run:   ./build/encom-hits          (play)
#        ./build/encom-hits --ppm    (write the 14 reference screens to /tmp)

# stdlib deps resolved via cyrius.cyml -- string, alloc, syscalls, vec, assert
# auto-prepended (run `cyrius deps` once to vendor lib/)

include "src/types.cyr"
include "src/engine.cyr"
include "src/input.cyr"
include "src/draw.cyr"
include "src/text.cyr"
include "src/lightcycles.cyr"
include "src/grid.cyr"
include "src/gridbugs.cyr"
include "src/ai.cyr"
include "src/tanks.cyr"
include "src/mcpcone.cyr"
include "src/interceptors.cyr"
include "src/discs.cyr"
include "src/glow.cyr"
include "src/scores.cyr"
include "src/screens.cyr"
include "src/play.cyr"

var game_running = 0;

fn _screenshot_render(fb, path) {
    glow_apply(fb, SCREEN_W, SCREEN_H);
    engine_write_ppm_to(path);
    return 0;
}

fn _screenshot_mode(fb) {
    # Splash
    splash_render(fb);
    _screenshot_render(fb, "/tmp/encom_splash.ppm");

    # Menu
    menu_render(fb);
    _screenshot_render(fb, "/tmp/encom_menu.ppm");

    # Title cards
    title_render(fb, GAME_LIGHTCYCLES);
    _screenshot_render(fb, "/tmp/encom_title_lightcycles.ppm");

    title_render(fb, GAME_GRIDBUGS);
    _screenshot_render(fb, "/tmp/encom_title_gridbugs.ppm");

    title_render(fb, GAME_TANKS);
    _screenshot_render(fb, "/tmp/encom_title_tanks.ppm");

    title_render(fb, GAME_MCPCONE);
    _screenshot_render(fb, "/tmp/encom_title_mcpcone.ppm");

    title_render(fb, GAME_INTERCEPTORS);
    _screenshot_render(fb, "/tmp/encom_title_interceptors.ppm");

    title_render(fb, GAME_DISCS);
    _screenshot_render(fb, "/tmp/encom_title_discs.ppm");

    # Light Cycles — simulate a few ticks for visible trails
    lc_init();
    var i = 0;
    while (i < 25) {
        lc_p2_dir = ai_lightcycles(lc_p2_x, lc_p2_y, lc_p2_dir, LC_GRID_W, LC_GRID_H);
        lc_update();
        i = i + 1;
    }
    lc_render(fb);
    _screenshot_render(fb, "/tmp/encom_lightcycles.ppm");

    # Grid Bugs — init and render starting state
    gb_init(1);
    gb_render(fb);
    _screenshot_render(fb, "/tmp/encom_gridbugs.ppm");

    # Battle Tanks — init maze and render
    tk_init(54321);
    tk_render(fb);
    _screenshot_render(fb, "/tmp/encom_tanks.ppm");

    # MCP Cone — init and simulate a few ticks for rotation
    mcp_init();
    i = 0;
    while (i < 10) {
        mcp_update();
        i = i + 1;
    }
    mcp_render(fb);
    _screenshot_render(fb, "/tmp/encom_mcpcone.ppm");

    # Interceptors — spawn a wave
    int_init();
    int_spawn_wave();
    int_render(fb);
    _screenshot_render(fb, "/tmp/encom_interceptors.ppm");

    # Disc Arena — init with both discs
    disc_init();
    disc_render(fb);
    _screenshot_render(fb, "/tmp/encom_discs.ppm");

    return 0;
}

var _cmd_buf[64];

fn _say(msg) {
    syscall(SYS_WRITE, 2, msg, strlen(msg));
    return 0;
}

# 1 when one of the program's arguments (argv[1] onward) is exactly `flag`.
# /proc/self/cmdline holds the argv strings, each NUL-terminated. Through 0.8.2
# main matched the five bytes "--ppm" anywhere in it, argv[0] included, so
# "--ppmx" or a binary run from a path containing "--ppm" took screenshot mode.
fn _cmdline_has(buf, len, flag) {
    var flen = strlen(flag);
    var start = 0;
    var arg = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 0) {
            if (arg > 0) {
                if (i - start == flen) {
                    var k = 0;
                    while (k < flen) {
                        if (load8(buf + start + k) != load8(flag + k)) { k = flen + 1; }
                        else { k = k + 1; }
                    }
                    if (k == flen) { return 1; }
                }
            }
            arg = arg + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();

    # Read command line to check for --ppm flag
    var ppm_mode = 0;
    var cmd_fd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0);
    if (cmd_fd >= 0) {
        var cmd_len = syscall(SYS_READ, cmd_fd, &_cmd_buf, 512);
        syscall(SYS_CLOSE, cmd_fd);
        ppm_mode = _cmdline_has(&_cmd_buf, cmd_len, "--ppm");
    }

    var fb = engine_init();
    if (fb == 0) {
        _say("encom-hits: out of memory for the framebuffer\n");
        return 1;
    }
    scores_load();

    if (ppm_mode == 1) {
        _screenshot_mode(fb);
        engine_shutdown();
        return 0;
    }

    if (input_init() == 0) {
        engine_shutdown();
        _say("encom-hits: stdin is not a terminal; run it from a console (or use --ppm for headless screenshots)\n");
        return 1;
    }

    # Splash screen — 4 seconds, or until any key. Q (or Ctrl+C) quits.
    var splash_timer = 240;
    while (splash_timer > 0) {
        engine_tick_begin();
        input_poll();
        splash_render(fb);
        glow_apply(fb, SCREEN_W, SCREEN_H);
        engine_present();
        splash_timer = splash_timer - 1;
        if (input_any() == 1) { splash_timer = 0; }
        if (input_quit() == 1) {
            input_shutdown();
            engine_shutdown();
            return 0;
        }
        engine_tick_wait();
    }

    current_game = GAME_MENU;
    game_running = 1;

    while (game_running == 1) {
        engine_tick_begin();
        input_poll();
        play_frame(fb);
        engine_present();

        if (input_quit() == 1) {
            game_running = 0;
        }

        engine_tick_wait();
    }

    input_shutdown();
    engine_shutdown();
    return 0;
}

var exit_code = main();
syscall(SYS_EXIT, exit_code);
